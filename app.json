{
  "expo": {
    "name": "Banana",
    "slug": "banana",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "banana",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.banana.app",
      "minSdkVersion": 29,
      "predictiveBackGestureEnabled": false,
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Banana records the leaflet you choose to dictate, including while another app is open.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Banana uses the microphone only while you dictate meal wishes.",
          "speechRecognitionPermission": "Banana transcribes your voice so you can dictate next week's meals."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
